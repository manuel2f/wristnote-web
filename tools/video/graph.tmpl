
  [0:v]fps=30,split[pr1][pr2];
  [pr1]trim=0:1.9,setpts=PTS-STARTPTS,tpad=start_duration=1.5:start_mode=clone[pa];
  [pr2]trim=2.6:11.4,setpts=PTS-STARTPTS,tpad=stop_duration=2:stop_mode=clone,trim=0:8.8,setpts=PTS-STARTPTS[pb];
  [1:v]fps=30,split[pn1][pn2];
  [pn1]trim=0:0.2,setpts=PTS-STARTPTS,tpad=stop_duration=3:stop_mode=clone,trim=0:3,setpts=PTS-STARTPTS[pc];
  [pn2]trim=1.0:6.0,setpts=PTS-STARTPTS,tpad=stop_duration=6:stop_mode=clone,trim=0:9.8,setpts=PTS-STARTPTS[pd];
  [pa][pb][pc][pd]concat=n=4,scale=396:880:flags=lanczos,format=rgba[ps];
  [14:v]format=gray,trim=0:25[pm]; [ps][pm]alphamerge[phone];
  [2:v]fps=30,trim=0:3.4,setpts=PTS-STARTPTS,tpad=stop_duration=1:stop_mode=clone,trim=0:3.4,setpts=PTS-STARTPTS,format=rgba[wa];
  [3:v]fps=30,scale=454:454,format=rgba[wb];
  [4:v]fps=30,setpts=PTS-STARTPTS,tpad=stop_duration=1:stop_mode=clone,trim=0:3,setpts=PTS-STARTPTS,format=rgba[wc];
  [5:v]fps=30,scale=454:454,format=rgba[wd];
  [wa][wb][wc][wd]concat=n=4,scale=400:400:flags=lanczos,format=rgba[ws];
  [15:v]format=gray,trim=0:25[wm]; [ws][wm]alphamerge[watch];
  [8:v]format=rgba,fade=t=in:st=2.85:d=0.12:alpha=1,fade=t=out:st=3.1:d=0.3:alpha=1[tap];
  $(cap 1 0 3.4) $(cap 2 3.4 12.2) $(cap 3 12.2 15.2) $(cap 4 15.2 21.5)
  [13:v]format=rgba,fade=t=in:st=21.5:d=0.7:alpha=1[end];
  [6:v]fps=30,format=rgba[bg];
  [bg][phone]overlay=${PX}:${PY}:shortest=1[v1];
  [v1][watch]overlay=${WX}:${WY}[v2];
  [v2][7:v]overlay=0:0[v3];
  [v3][tap]overlay=870:608:enable='between(t,2.8,3.45)'[v4];
  [v4][c1]overlay=0:0:enable='lt(t,3.4)'[v5];
  [v5][c2]overlay=0:0:enable='between(t,3.4,12.2)'[v6];
  [v6][c3]overlay=0:0:enable='between(t,12.2,15.2)'[v7];
  [v7][c4]overlay=0:0:enable='between(t,15.2,21.5)'[v8];
  [v8][end]overlay=0:0:enable='gte(t,21.5)',fade=t=in:st=0:d=0.5,format=yuv420p[out]